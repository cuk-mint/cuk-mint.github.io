# 로컬에서 미리보기를 하고 싶을 때만 필요합니다.
# GitHub Pages 에 올리면 이 파일 없이도 알아서 빌드됩니다.
#
#   gem install bundler
#   bundle install
#   bundle exec jekyll serve
#   → http://127.0.0.1:4000

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"   # Ruby 3.0+ 에서 jekyll serve 에 필요
